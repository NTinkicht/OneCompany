{
  "$schema": "./schemas/governance.schema.json",
  "schema_version": "1.2",
  "control_plane": {
    "human_merge_required": false,
    "fail_closed_if_diff_unavailable": true,
    "protected_paths": [
      ".onecompany/**",
      "scripts/**",
      "company/**",
      "agents/**",
      "patterns/**",
      "overlays/**",
      ".github/**",
      "onecompany.py",
      "Makefile",
      "AGENTS.md",
      "CLAUDE.md",
      "GEMINI.md"
    ],
    "always_human_paths": [
      "company/CONSTITUTION.md",
      ".onecompany/governance.json",
      ".onecompany/required-checks.json",
      ".github/CODEOWNERS",
      ".github/workflows/**"
    ]
  },
  "supply_chain": {
    "all_workflow_actions_require_sha_pin": true,
    "forbid_pull_request_target_in_all_workflows": true,
    "forbid_write_all_in_all_workflows": true
  },
  "side_effects": {
    "require_idempotency_or_natural_deduplication": true,
    "require_rollback_or_compensation_for_destructive_actions": true,
    "require_bounded_retry_policy": true
  },
  "policy": {
    "no_self_escalation": true,
    "control_plane_relaxation_requires_human": true,
    "ambiguity_fails_closed": true
  }
}
