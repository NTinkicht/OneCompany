{
  "$schema": "./schemas/l5.schema.json",
  "schema_version": "1.0",
  "level": "L5_CANDIDATE",
  "phase": "L4.1_CONTINUITY",
  "mutation_mode": "PLAN_ONLY",
  "repositories": [
    {
      "repository": "NTinkicht/Tabibi",
      "target_open_prs": 3,
      "base_branch": "main"
    },
    {
      "repository": "NTinkicht/OneCompany",
      "target_open_prs": 2,
      "base_branch": "main"
    },
    {
      "repository": "NTinkicht/veritas-atlas",
      "target_open_prs": 2,
      "base_branch": "main"
    }
  ],
  "ready_labels": ["l5-ready", "l4-ready"],
  "blocking_labels": ["l5-blocked", "l4-blocked", "human-only", "release-go-no-go"],
  "human_only_boundaries": [
    "new_paid_vendor_or_spend",
    "credential_or_secret_creation_rotation",
    "destructive_production_or_database_operation",
    "legal_or_compliance_commitment",
    "irreversible_product_direction",
    "weakening_l5_governance_or_emergency_stop"
  ],
  "state_machine": [
    "SELECTED",
    "IMPLEMENTING",
    "TESTING",
    "REVIEWING",
    "REMEDIATING",
    "MERGE_READY",
    "MERGED",
    "VERIFYING",
    "COMPLETE"
  ],
  "promotion_requirements": [
    "repo-local continuity policies merged",
    "three consecutive quota reconciliations produce deterministic plans",
    "fault injection covers stale head/base, CI failure, reviewer outage and emergency stop",
    "no eligible work is invented when backlog is not ready",
    "mutation activation is a separate reviewed governance change"
  ]
}
