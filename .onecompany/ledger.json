{
  "$schema": "./schemas/ledger.schema.json",
  "schema_version": "1.1",
  "enabled": false,
  "issue_number": null,
  "trusted_publisher_logins": [],
  "required_for_autonomous_merge": true,
  "required_for_continuous_autonomy": true,
  "event_format_version": 2,
  "accepted_event_versions": [1, 2],
  "legacy_event_max_comment_id": 0,
  "legacy_v1_actor_limits": {
    "human-owner": 1,
    "chatgpt": 1,
    "codex": 1,
    "claude": 1,
    "github-copilot": 1,
    "gemini-cli": 1,
    "mistral-vibe": 1
  },
  "legacy_v1_unknown_actor_limit": 1,
  "accepted_event_types": [
    "ROLE_LEASE_ASSIGNED",
    "ROLE_LEASE_RELEASED",
    "ROLE_LEASE_TRANSFERRED",
    "MATERIAL_AUTHOR",
    "GATE",
    "CAPACITY_DEGRADED",
    "CAPACITY_RECOVERED",
    "SUPERVISION_CHECK",
    "HUMAN_DECISION",
    "INTEGRITY_CONFLICT_RESOLVED",
    "MERGED"
  ],
  "policy": {
    "github_issue_comments_are_durable_coordination_record": true,
    "local_state_is_cache": true,
    "ignore_untrusted_publishers": true,
    "binding_gate_must_be_durable": true,
    "continuous_supervisors_must_share_ledger": true,
    "lease_admission_is_immutable_at_grant": true,
    "current_actor_eligibility_is_runtime_status_not_replay_authority": true,
    "legacy_v1_events_require_migration_cutoff": true,
    "legacy_v1_capacity_is_frozen_at_migration": true,
    "v2_dependency_completion_requires_preceding_merge_evidence": true
  }
}
