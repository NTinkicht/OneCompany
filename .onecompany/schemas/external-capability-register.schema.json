{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecompany.dev/schemas/external-capability-register.schema.json",
  "title": "OneCompany External Capability and Integration Register",
  "description": "Phase 0 planning only; never authorizes WU admission, spending, provider installation, leases, review or merge.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "register_id",
    "source",
    "as_of_date",
    "authority",
    "planning_rules",
    "group_workstreams",
    "candidates"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/external-capability-register.schema.json"
    },
    "schema_version": {
      "const": "0.1-planning"
    },
    "register_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "as_of_date": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "planning_rules": {
      "type": "object"
    },
    "group_workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "epic",
          "phase",
          "purpose",
          "wu",
          "deps",
          "status"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "epic": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "purpose": {
            "type": "string"
          },
          "wu": {
            "type": "string"
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "const": "PROPOSED"
          }
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "repository_or_project",
          "candidate_url",
          "capability_categories",
          "strategic_purpose",
          "problem_addressed",
          "onecompany_component",
          "existing_equivalent",
          "proposed_integration_approach",
          "required_provider_interface_contract",
          "dependencies",
          "target_implementation_phase",
          "user_visible_benefit",
          "cost_implications",
          "infrastructure_implications",
          "privacy_security_implications",
          "license_commercial_use_assessment",
          "validation_proof_of_value",
          "acceptance_criteria",
          "proposed_epic",
          "work_unit_mappings",
          "candidate_assessment_task",
          "assessment_task_status",
          "adoption_decision",
          "adoption_status",
          "defer_trigger",
          "reason_if_not_selected"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^EXT-[0-9]{3,}$"
          },
          "repository_or_project": {
            "type": "string",
            "minLength": 3
          },
          "candidate_url": {
            "type": "string",
            "pattern": "^https://github\\.com/"
          },
          "capability_categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "MEM",
                "INF",
                "HAR",
                "COM",
                "SPEC",
                "PROD",
                "QUAL",
                "UI",
                "DES",
                "OBS",
                "OPS"
              ]
            }
          },
          "strategic_purpose": {
            "type": "string",
            "minLength": 10
          },
          "problem_addressed": {
            "type": "string",
            "minLength": 10
          },
          "onecompany_component": {
            "type": "string",
            "minLength": 5
          },
          "existing_equivalent": {
            "type": "string",
            "minLength": 5
          },
          "proposed_integration_approach": {
            "type": "string",
            "minLength": 10
          },
          "required_provider_interface_contract": {
            "type": "string",
            "minLength": 10
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "target_implementation_phase": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "user_visible_benefit": {
            "type": "string",
            "minLength": 10
          },
          "cost_implications": {
            "type": "string",
            "minLength": 10
          },
          "infrastructure_implications": {
            "type": "string",
            "minLength": 10
          },
          "privacy_security_implications": {
            "type": "string",
            "minLength": 10
          },
          "license_commercial_use_assessment": {
            "type": "string",
            "minLength": 10
          },
          "validation_proof_of_value": {
            "type": "string",
            "minLength": 10
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "proposed_epic": {
            "type": "string",
            "pattern": "^EPIC-"
          },
          "work_unit_mappings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^WU-"
            }
          },
          "candidate_assessment_task": {
            "type": "string",
            "pattern": "^ASSESS-EXT-"
          },
          "assessment_task_status": {
            "const": "PROPOSED_NOT_ADMITTED"
          },
          "adoption_decision": {
            "enum": [
              "INTEGRATE",
              "EXPERIMENT",
              "BORROW ARCHITECTURAL PATTERNS",
              "DEFER IMPLEMENTATION",
              "REJECT AFTER EVIDENCE-BASED ASSESSMENT"
            ]
          },
          "adoption_status": {
            "const": "PLANNED_NOT_INSTALLED"
          },
          "defer_trigger": {
            "type": "string",
            "minLength": 10
          },
          "reason_if_not_selected": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
