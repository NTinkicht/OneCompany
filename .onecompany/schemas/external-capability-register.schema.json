{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecompany.dev/schemas/external-capability-register.schema.json",
  "title": "OneCompany External Capability and Integration Register",
  "description": "Phase 0 planning only; never authorizes WU admission, spending, provider installation, leases, review or merge.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "register_id",
    "source",
    "as_of_date",
    "authority",
    "planning_rules",
    "group_workstreams",
    "candidates",
    "protected_future_commitments"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/external-capability-register.schema.json"
    },
    "schema_version": {
      "const": "0.1-planning"
    },
    "register_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "as_of_date": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "planning_rules": {
      "type": "object"
    },
    "group_workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "epic",
          "phase",
          "purpose",
          "wu",
          "deps",
          "status"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "epic": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "purpose": {
            "type": "string"
          },
          "wu": {
            "type": "string"
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "const": "PROPOSED"
          }
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 61,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "repository_or_project",
          "candidate_url",
          "capability_categories",
          "strategic_purpose",
          "problem_addressed",
          "onecompany_component",
          "existing_equivalent",
          "proposed_integration_approach",
          "required_provider_interface_contract",
          "dependencies",
          "target_implementation_phase",
          "user_visible_benefit",
          "cost_implications",
          "infrastructure_implications",
          "privacy_security_implications",
          "license_commercial_use_assessment",
          "validation_proof_of_value",
          "acceptance_criteria",
          "proposed_epic",
          "work_unit_mappings",
          "candidate_assessment_task",
          "assessment_task_status",
          "adoption_decision",
          "adoption_status",
          "defer_trigger",
          "reason_if_not_selected"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^EXT-[0-9]{3,}$",
            "enum": [
              "EXT-001",
              "EXT-002",
              "EXT-003",
              "EXT-004",
              "EXT-005",
              "EXT-006",
              "EXT-007",
              "EXT-008",
              "EXT-009",
              "EXT-010",
              "EXT-011",
              "EXT-012",
              "EXT-013",
              "EXT-014",
              "EXT-015",
              "EXT-016",
              "EXT-017",
              "EXT-018",
              "EXT-019",
              "EXT-020",
              "EXT-021",
              "EXT-022",
              "EXT-023",
              "EXT-024",
              "EXT-025",
              "EXT-026",
              "EXT-027",
              "EXT-028",
              "EXT-029",
              "EXT-030",
              "EXT-031",
              "EXT-032",
              "EXT-033",
              "EXT-034",
              "EXT-035",
              "EXT-036",
              "EXT-037",
              "EXT-038",
              "EXT-039",
              "EXT-040",
              "EXT-041",
              "EXT-042",
              "EXT-043",
              "EXT-044",
              "EXT-045",
              "EXT-046",
              "EXT-047",
              "EXT-048",
              "EXT-049",
              "EXT-050",
              "EXT-051",
              "EXT-052",
              "EXT-053",
              "EXT-054",
              "EXT-055",
              "EXT-056",
              "EXT-057",
              "EXT-058",
              "EXT-059",
              "EXT-060",
              "EXT-061"
            ]
          },
          "repository_or_project": {
            "type": "string",
            "minLength": 3,
            "enum": [
              "NTinkicht/supermemory",
              "volcengine/OpenViking",
              "NTinkicht/kserve",
              "BerriAI/litellm",
              "lm-sys/RouteLLM",
              "aurelio-labs/semantic-router",
              "microsoft/LLMLingua",
              "OpenHands/software-agent-sdk",
              "openai/openai-agents-python",
              "anthropics/claude-agent-sdk-python",
              "badlogic/pi-mono",
              "strands-agents/harness-sdk",
              "twaldin/harness",
              "AMAP-ML/LongHorizon-Harness",
              "langchain-ai/open-swe",
              "e2b-dev/E2B",
              "kubernetes-sigs/agent-sandbox",
              "temporalio/temporal",
              "a2aproject/A2A",
              "nats-io/nats-server",
              "ag-ui-protocol/ag-ui",
              "agentskills/agentskills",
              "modelcontextprotocol/registry",
              "github/spec-kit",
              "Fission-AI/OpenSpec",
              "bmad-code-org/BMAD-METHOD",
              "nrwl/nx",
              "sverweij/dependency-cruiser",
              "backstage/backstage",
              "makeplane/plane",
              "opf/openproject",
              "xyflow/xyflow",
              "cytoscape/cytoscape.js",
              "mermaid-js/mermaid",
              "microsoft/playwright",
              "stryker-mutator/stryker-js",
              "schemathesis/schemathesis",
              "HypothesisWorks/hypothesis",
              "pact-foundation/pact-js",
              "grafana/k6",
              "dequelabs/axe-core",
              "aquasecurity/trivy",
              "semgrep/semgrep",
              "OWASP/ASVS",
              "confident-ai/deepeval",
              "promptfoo/promptfoo",
              "google/artemis",
              "browserbase/stagehand",
              "mobile-dev-inc/Maestro",
              "lost-pixel/lost-pixel",
              "penpot/penpot",
              "storybookjs/storybook",
              "shadcn-ui/ui",
              "langfuse/langfuse",
              "open-telemetry/opentelemetry-python",
              "CopilotKit/CopilotKit",
              "assistant-ui/assistant-ui",
              "renovatebot/renovate",
              "argoproj/argo-cd",
              "chaos-mesh/chaos-mesh",
              "github/gh-aw"
            ]
          },
          "candidate_url": {
            "type": "string",
            "pattern": "^https://github\\.com/"
          },
          "capability_categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "MEM",
                "INF",
                "HAR",
                "COM",
                "SPEC",
                "PROD",
                "QUAL",
                "UI",
                "DES",
                "OBS",
                "OPS"
              ]
            }
          },
          "strategic_purpose": {
            "type": "string",
            "minLength": 10
          },
          "problem_addressed": {
            "type": "string",
            "minLength": 10
          },
          "onecompany_component": {
            "type": "string",
            "minLength": 5
          },
          "existing_equivalent": {
            "type": "string",
            "minLength": 5
          },
          "proposed_integration_approach": {
            "type": "string",
            "minLength": 10
          },
          "required_provider_interface_contract": {
            "type": "string",
            "minLength": 10
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "target_implementation_phase": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "user_visible_benefit": {
            "type": "string",
            "minLength": 10
          },
          "cost_implications": {
            "type": "string",
            "minLength": 10
          },
          "infrastructure_implications": {
            "type": "string",
            "minLength": 10
          },
          "privacy_security_implications": {
            "type": "string",
            "minLength": 10
          },
          "license_commercial_use_assessment": {
            "type": "string",
            "minLength": 10
          },
          "validation_proof_of_value": {
            "type": "string",
            "minLength": 10
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "proposed_epic": {
            "type": "string",
            "pattern": "^EPIC-"
          },
          "work_unit_mappings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^WU-"
            }
          },
          "candidate_assessment_task": {
            "type": "string",
            "pattern": "^ASSESS-EXT-"
          },
          "assessment_task_status": {
            "const": "PROPOSED_NOT_ADMITTED"
          },
          "adoption_decision": {
            "enum": [
              "INTEGRATE",
              "EXPERIMENT",
              "BORROW ARCHITECTURAL PATTERNS",
              "DEFER IMPLEMENTATION",
              "REJECT AFTER EVIDENCE-BASED ASSESSMENT"
            ]
          },
          "adoption_status": {
            "const": "PLANNED_NOT_INSTALLED"
          },
          "defer_trigger": {
            "type": "string",
            "minLength": 10
          },
          "reason_if_not_selected": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      },
      "maxItems": 61
    },
    "protected_future_commitments": {
      "type": "object",
      "required": [
        "NTinkicht/kserve",
        "NTinkicht/supermemory",
        "volcengine/OpenViking",
        "google/artemis"
      ],
      "properties": {
        "NTinkicht/kserve": {
          "const": "WU-P2-KSERVE-001"
        },
        "NTinkicht/supermemory": {
          "const": "WU-P2-SUPERMEMORY-001"
        },
        "volcengine/OpenViking": {
          "const": "WU-P2-OPENVIKING-001"
        },
        "google/artemis": {
          "const": "WU-P2-ARTEMIS-001"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
