{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OneCompany Trusted Kernel Boundary Policy",
  "type": "object",
  "required": ["schema_version", "trusted_modules", "trusted_data", "forbidden_repo_import_roots"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "trusted_modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "trusted_data": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_repo_import_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
