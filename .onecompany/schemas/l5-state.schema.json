{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecompany.local/schemas/l5-state.schema.json",
  "title": "OneCompany L5 durable orchestration evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "issue",
    "canonical_pr",
    "active_prs",
    "head_sha",
    "base_sha",
    "head_current",
    "base_current",
    "implementation_complete",
    "ci",
    "ci_head_sha",
    "ci_base_sha",
    "review",
    "review_head_sha",
    "review_base_sha",
    "reviewer_actor",
    "material_authors",
    "review_eligible",
    "mergeable",
    "merged",
    "verified",
    "emergency_stop",
    "human_only",
    "blocked"
  ],
  "properties": {
    "repository": {"type": "string", "minLength": 3},
    "issue": {"type": "integer", "minimum": 1},
    "canonical_pr": {"type": ["integer", "null"], "minimum": 1},
    "active_prs": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "head_current": {"type": "boolean"},
    "base_current": {"type": "boolean"},
    "implementation_complete": {"type": "boolean"},
    "ci": {"enum": ["UNKNOWN", "PENDING", "SUCCESS", "FAILURE", "CANCELLED", "TIMED_OUT"]},
    "ci_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "ci_base_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "review": {"enum": ["UNKNOWN", "PENDING", "PASS", "FINDINGS", "CHANGES_REQUESTED", "OUTAGE"]},
    "review_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "review_base_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "reviewer_actor": {"type": ["string", "null"]},
    "material_authors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "review_eligible": {"type": "boolean"},
    "unresolved_threads": {"type": "boolean"},
    "mergeable": {"type": "boolean"},
    "merged": {"type": "boolean"},
    "verified": {"type": "boolean"},
    "emergency_stop": {"type": "boolean"},
    "human_only": {"type": "boolean"},
    "blocked": {"type": "boolean"}
  }
}
