{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecompany.dev/schemas/ledger.schema.json",
  "title": "OneCompany Durable Coordination Ledger",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "enabled",
    "issue_number",
    "trusted_publisher_logins",
    "required_for_autonomous_merge",
    "required_for_continuous_autonomy",
    "event_format_version",
    "accepted_event_versions",
    "legacy_event_max_comment_id",
    "legacy_v1_actor_limits",
    "legacy_v1_unknown_actor_limit",
    "lease_lifecycle",
    "accepted_event_types"
  ],
  "properties": {
    "$schema": {"const": "./schemas/ledger.schema.json"},
    "schema_version": {"const": "1.3"},
    "enabled": {"type": "boolean"},
    "issue_number": {"type": ["integer", "null"], "minimum": 1},
    "trusted_publisher_logins": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "required_for_autonomous_merge": {"type": "boolean"},
    "required_for_continuous_autonomy": {"type": "boolean"},
    "event_format_version": {"type": "integer", "minimum": 2},
    "accepted_event_versions": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "legacy_event_max_comment_id": {"type": "integer", "minimum": 0},
    "legacy_v1_actor_limits": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "legacy_v1_unknown_actor_limit": {"type": "integer", "minimum": 0},
    "lease_lifecycle": {
      "type": "object",
      "required": [
        "ttl_seconds",
        "renewal_progress_kinds",
        "implicit_expiry_revokes_authority"
      ],
      "properties": {
        "ttl_seconds": {"type": "integer", "minimum": 1},
        "renewal_progress_kinds": {
          "type": "array",
          "items": {"enum": ["pr_head"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "implicit_expiry_revokes_authority": {"const": true}
      },
      "additionalProperties": false
    },
    "accepted_event_types": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
