{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecompany.dev/schemas/ledger.schema.json",
  "title": "OneCompany Durable Coordination Ledger",
  "type": "object",
  "required": ["schema_version", "enabled", "issue_number", "trusted_publisher_logins", "required_for_autonomous_merge", "required_for_continuous_autonomy", "event_format_version", "accepted_event_types", "policy"],
  "properties": {
    "schema_version": {"type": "string"},
    "enabled": {"type": "boolean"},
    "issue_number": {"type": ["integer", "null"], "minimum": 1},
    "trusted_publisher_logins": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_for_autonomous_merge": {"type": "boolean"},
    "required_for_continuous_autonomy": {"type": "boolean"},
    "event_format_version": {"type": "integer", "minimum": 1},
    "accepted_event_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "policy": {"type": "object"}
  },
  "additionalProperties": true
}
