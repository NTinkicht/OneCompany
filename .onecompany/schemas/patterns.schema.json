{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OneCompany Pattern Registry",
  "type": "object",
  "required": [
    "version",
    "patterns"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "adoption",
          "origin",
          "source",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "adoption": {
            "enum": [
              "core",
              "recommended",
              "optional",
              "experimental"
            ]
          },
          "origin": {
            "enum": [
              "adapted",
              "onecompany-native"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
