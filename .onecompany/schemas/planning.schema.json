{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecompany.dev/schemas/planning.schema.json",
  "title": "OneCompany Planning Policy",
  "type": "object",
  "required": ["schema_version", "source_of_truth", "work_model", "planning_horizons", "prioritization", "estimation", "traceability", "parallel_execution", "flow", "automation"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string"},
    "source_of_truth": {
      "type": "object",
      "required": ["approved_baseline", "github_issues_are_collaboration_surface", "issue_edits_do_not_auto_baseline", "reconciliation_required"],
      "properties": {
        "approved_baseline": {"const": "versioned_control_plane"},
        "github_issues_are_collaboration_surface": {"const": true},
        "issue_edits_do_not_auto_baseline": {"const": true},
        "reconciliation_required": {"const": true}
      },
      "additionalProperties": false
    },
    "work_model": {
      "type": "object",
      "required": ["entity_types", "execution_item_types", "relationship_types", "execution_contract", "requirements_are_canonical_in", "acceptance_criteria_are_canonical_in", "risks_are_canonical_in"],
      "properties": {
        "entity_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "relationship_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "optional_layers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "execution_contract": {"type": "string"},
        "requirements_are_canonical_in": {"type": "string"},
        "acceptance_criteria_are_canonical_in": {"type": "string"},
        "risks_are_canonical_in": {"type": "string"},
        "execution_item_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "planning_horizons": {"type": "object"},
    "prioritization": {
      "type": "object",
      "required": ["method", "weights", "higher_score_first"],
      "properties": {
        "method": {"type": "string"},
        "weights": {"type": "object"},
        "score_inputs_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "higher_score_first": {"type": "boolean"},
        "estimates_are_forecasts_not_commitments": {"type": "boolean"}
      }
    },
    "estimation": {"type": "object"},
    "traceability": {"type": "object"},
    "parallel_execution": {
      "type": "object",
      "required": ["enabled", "max_concurrent_implementation_streams", "one_implementation_lease_per_work_unit", "require_write_scope_for_parallel", "unknown_scope_behavior", "critical_risk_default", "resource_locking", "conflict_policy"],
      "properties": {
        "enabled": {"type": "boolean"},
        "max_concurrent_implementation_streams": {"type": "integer", "minimum": 1, "maximum": 20},
        "one_implementation_lease_per_work_unit": {"type": "boolean"},
        "require_write_scope_for_parallel": {"type": "boolean"},
        "unknown_scope_behavior": {"enum": ["serialize", "allow"]},
        "critical_risk_default": {"enum": ["serialize", "policy"]},
        "resource_locking": {"type": "boolean"},
        "conflict_policy": {"enum": ["fail_closed", "fail_open"]}
      }
    },
    "flow": {"type": "object"},
    "automation": {"type": "object"}
  },
  "additionalProperties": false
}
