{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecompany.dev/schemas/queue.schema.json",
  "title": "OneCompany Queue",
  "type": "object",
  "required": ["schema_version", "work_units"],
  "properties": {
    "schema_version": {"type": "string"},
    "work_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "priority", "dependencies", "risk_class"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"enum": ["PROPOSED", "READY", "LEASED", "IN_PROGRESS", "CI_PENDING", "REVIEW_PENDING", "REMEDIATION", "MERGE_READY", "BLOCKED", "MERGED", "DONE", "CANCELLED"]},
          "priority": {"type": "integer"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "issue": {"type": ["integer", "null"]},
          "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
