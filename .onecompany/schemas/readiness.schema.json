{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OneCompany Actor Readiness Registry",
  "type": "object",
  "required": ["schema_version", "actors"],
  "properties": {
    "schema_version": {"type": "string"},
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actor_id",
          "setup_state",
          "verified_surfaces",
          "verified_capabilities",
          "temporarily_unavailable_capabilities",
          "repository_access",
          "unattended",
          "capacity",
          "evidence"
        ],
        "properties": {
          "actor_id": {"type": "string", "minLength": 1},
          "setup_state": {"enum": ["not_started", "partially_ready", "ready", "degraded", "unavailable"]},
          "verified_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "verified_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "temporarily_unavailable_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "repository_access": {
            "type": "object",
            "required": ["read", "write", "review", "merge"],
            "properties": {
              "read": {"type": "boolean"},
              "write": {"type": "boolean"},
              "review": {"type": "boolean"},
              "merge": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "unattended": {
            "type": "object",
            "required": ["configured", "verified"],
            "properties": {
              "configured": {"type": "boolean"},
              "verified": {"type": "boolean"}
            },
            "additionalProperties": true
          },
          "capacity": {
            "type": "object",
            "required": ["implementation_streams", "review_streams"],
            "properties": {
              "implementation_streams": {"type": "integer", "minimum": 1},
              "review_streams": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "last_verified_at": {"type": ["string", "null"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
