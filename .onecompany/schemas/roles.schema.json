{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecompany.dev/schemas/roles.schema.json",
  "title": "OneCompany Roles",
  "type": "object",
  "required": ["schema_version", "roles"],
  "properties": {
    "schema_version": {"type": "string"},
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "purpose", "required_capabilities", "write_scope", "conflicts"],
        "properties": {
          "id": {"type": "string"},
          "purpose": {"type": "string"},
          "required_capabilities": {"type": "array", "items": {"type": "string"}},
          "write_scope": {"type": "string"},
          "conflicts": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
