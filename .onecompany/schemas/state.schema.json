{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecompany.dev/schemas/state.schema.json",
  "title": "OneCompany State",
  "type": "object",
  "required": ["schema_version", "company_state", "current_material_authors", "active_leases", "active_streams", "ready_work_count", "safe_start_candidates", "open_blockers", "human_decision_required"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string"},
    "generated_or_reconciled_at": {"type": ["string", "null"]},
    "repository_head": {"type": ["string", "null"]},
    "company_state": {"type": "string"},
    "current_work_unit": {"type": ["string", "null"]},
    "current_pr": {"type": ["integer", "null"]},
    "current_pr_head": {"type": ["string", "null"]},
    "current_material_authors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "active_leases": {"type": "array", "items": {"type": "object"}},
    "active_streams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_unit", "lease_id", "status", "open_blockers", "human_decision_required"],
        "properties": {
          "work_unit": {"type": "string"},
          "lease_id": {"type": "string"},
          "actor": {"type": ["string", "null"]},
          "branch": {"type": ["string", "null"]},
          "pr": {"type": ["integer", "null"]},
          "head": {"type": ["string", "null"]},
          "base_sha": {"type": ["string", "null"]},
          "status": {"type": "string"},
          "material_authors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "gate": {"type": ["object", "null"]},
          "open_blockers": {"type": "array"},
          "human_decision_required": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "current_gate": {"type": ["object", "null"]},
    "ready_work_count": {"type": "integer", "minimum": 0},
    "safe_start_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "open_blockers": {"type": "array"},
    "human_decision_required": {"type": "boolean"},
    "note": {"type": "string"}
  },
  "additionalProperties": true
}
