{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-reference.schema.json",
  "title": "OneCompany Platform Evidence Reference",
  "type": "object",
  "required": ["id", "provider", "source_kind", "workflow_run_id", "artifact_id", "artifact_name", "parser"],
  "properties": {
    "id": {"type": "string", "pattern": "^EVID-[0-9]{3,}$"},
    "provider": {"const": "github_actions"},
    "source_kind": {"const": "artifact"},
    "workflow_run_id": {"type": "integer", "minimum": 1},
    "artifact_id": {"type": "integer", "minimum": 1},
    "artifact_name": {"type": "string", "minLength": 1},
    "parser": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "enum": [
            "onecompany_quality_json_v1",
            "cobertura_xml",
            "junit_xml",
            "onecompany_mutation_json_v1"
          ]
        },
        "version": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
